# Config de documentos-service (12-factor III: toda la config por entorno)
APP_NAME=documentos-service
DEBUG=false
# Desarrollo con Mongo simulado (rápido, sin instalar nada):
#   DATABASE_URL=mongomock://localhost
# Desarrollo/producción con Mongo real (paridad dev/prod, 12-factor X):
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=documentos_service
DATABASE_TIMEOUT_MS=5000
API_V1_PREFIX=/api/v1
# Shared secret also configured as DOCUMENTOS_SERVICE_API_KEY in extraccion-service.
EXTRACTION_SERVICE_API_KEY=

# Consul is optional; leave empty to disable registration for standalone runs.
CONSUL_HTTP_ADDR=
CONSUL_HTTP_TOKEN=
CONSUL_SERVICE_NAME=documentos-service
CONSUL_SERVICE_PORT=8000
# Comma-separated Consul tags, e.g. traefik.enable=true,team=documentos
CONSUL_SERVICE_TAGS=
# Optional instance-reachable address; otherwise inferred from the Consul route.
CONSUL_SERVICE_ADDRESS=
